<style>
    .portal-navbar {
        position: relative;
        z-index: 100;
        width: 100%;
        min-height: 78px;
        padding: 12px 0;
        background: #172b35;
        transition: background 0.3s ease;
    }

    /* Transparent navigation on the homepage */
    body:has(.home-hero) .portal-navbar {
        position: absolute;
        top: 0;
        left: 0;
        background: rgba(15, 20, 22, 0.25);
        backdrop-filter: blur(5px);
    }

    .portal-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        color: white !important;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 2px;
        line-height: 1.4;
    }

