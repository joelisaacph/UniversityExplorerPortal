@page "/student-applications"
@inject StudentApplicationService ApplicationService
@inject NavigationManager Navigation

<PageTitle>Student Applications</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Student Applications</h1>
    <a href="student-applications/create" class="btn btn-primary">+ New Application</a>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center">
        <div class="spinner-border text-primary me-3" role="status"></div>
        <p class="mb-0">Loading...</p>
    </div>
}
else if (hasError)
{
    <div class="alert alert-danger">
        Unable to retrieve data. The Student Application API could not be reached.
        <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadApplicationsAsync">Try again</button>
    </div>
}
else if (applications.Count == 0)
{
    <div class="alert alert-info">There are no applications yet. <a href="student-applications/create">Create the first one.</a></div>
}
else
{
    <StudentApplicationTable Applications="applications" OnEdit="HandleEdit" />
}

@code {
    private List<StudentApplication> applications = new();
    private bool isLoading = true;
    private bool hasError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadApplicationsAsync();
    }

    private async Task LoadApplicationsAsync()
    {
        isLoading = true;
        hasError = false;

        try
        {
            applications = await ApplicationService.GetApplicationsAsync();
        }
        catch (Exception)
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    // The table tells us which application the user wants to edit
    private void HandleEdit(StudentApplication application)
    {
        Navigation.NavigateTo($"/student-applications/edit/{application.Id}");
    }
}
